# Copy to .env next to docker-compose.yml; Compose interpolates it
# automatically. No secrets are required by this app — all values are
# configuration. See docs/DEPLOY.md for semantics.

# Port the container listens on (and the published host port).
PORT=8080

# Log level filter for the Rust backend (tracing-subscriber env filter).
RUST_LOG=info

# Base URL of the NASA/IPAC IRSA service.
IRSA_BASE_URL=https://irsa.ipac.caltech.edu

# Comma-separated IRSA collections to query (order = query priority).
IRSA_COLLECTIONS=spherex_dr1,spherex_qr3

# Max concurrent outbound requests to IRSA (IRSA is a shared public service;
# keep <= 3). Retries with backoff on 503/429 are handled by the backend.
IRSA_MAX_CONCURRENCY=3

# Upper bound on frames returned per /api/v1/frames request (contract max: 120).
MAX_FRAMES=60

# Byte cap for the in-memory cutout cache, in MiB.
MAX_CACHE_MB=200

# Comma-separated CORS origins. The backend serves the frontend same-origin,
# so "*" is acceptable; restrict to the public URL if you embed the app.
ALLOWED_ORIGINS=*

# Per-client API rate limit, requests per second.
RATE_LIMIT_RPS=20

# Comma-separated "ra,dec" targets pre-warmed into the cache at startup,
# e.g. the five preset targets. Leave empty to disable.
WARM_TARGETS=

# Copy to .env next to docker-compose.yml; Compose interpolates it
# automatically. No secrets are required by this app — all values are
# configuration. Every variable is read by backend/src/config.rs or
# backend/src/irsa/config.rs; see docs/DEPLOY.md for semantics.

# Port the container listens on (and the published host port).
PORT=8080

# Log level filter for the Rust backend (tracing-subscriber env filter).
RUST_LOG=info

# Base URL of the NASA/IPAC IRSA service.
IRSA_BASE_URL=https://irsa.ipac.caltech.edu

# Comma-separated IRSA collections to query (order = query priority).
IRSA_COLLECTIONS=spherex_dr1,spherex_qr3

# Max concurrent outbound requests to IRSA (IRSA is a shared public service;
# keep <= 3). Retries with backoff on 503/429 are handled by the backend.
IRSA_MAX_CONCURRENCY=3

# Per-request timeout for a single IRSA call, seconds.
IRSA_TIMEOUT_SECS=15

# Attempts per IRSA call before giving up (with exponential backoff).
IRSA_MAX_ATTEMPTS=3

# Base backoff between IRSA retries, milliseconds.
IRSA_RETRY_BASE_MS=400

# Maximum accepted body size per IRSA response, MiB.
IRSA_MAX_BODY_MB=64

# Upper bound on frames returned per /api/v1/frames request (contract max: 60).
MAX_FRAMES=60

# Byte cap for the in-memory cutout cache, in MiB.
MAX_CACHE_MB=200

# Comma-separated CORS origins. Empty (the app default) is strictest: no
# cross-origin requests. The UI is served same-origin, so CORS is not
# needed unless you call the API from another site.
ALLOWED_ORIGINS=

# Per-client API rate limit, requests per second (also the burst size).
RATE_LIMIT_RPS=4

# Side of the square output raster for /api/v1/frames (contract max: 256).
OUTPUT_NPIX=192

# Total upstream-fetch budget per API request, seconds; on expiry the API
# returns partial frames with truncated=true.
REQUEST_DEADLINE_SECS=40

# Set to 1 (or true/yes/on) to pre-fetch the five preset targets through the
# cache at startup. This is a boolean flag, not a target list.
WARM_TARGETS=0
